# .env.example
# Copy this file to .env and fill in your actual credentials

# Display Name shown in the 'From' field
display_name="Your Name or Company"

# Email address used for SMTP login/authentication (REQUIRED)
# This is the email you use to log into your email provider
sender_email="your_login_email@gmail.com"

# Email address to display in the 'From' header (OPTIONAL)
# This can be different from sender_email for business/branded emails
# If not set, will use sender_email as fallback
from_email="your_display_email@yourdomain.com"

# Your email account password or App Password (REQUIRED)
password="your_app_password"

# SMTP Server Configuration (Optional - defaults to Gmail)
MAILER_HOST="smtp.gmail.com"
MAILER_PORT="587"

# Optional: Use an App Password for Gmail or other email providers
# (recommended for security)
# For Gmail, you can generate an App Password here:
# https://support.google.com/accounts/answer/185833?hl=en
# For other providers, check their documentation for generating App Passwords