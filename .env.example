# .env.example
# Copy this file to .env and fill in your actual credentials

# Display Name shown in the 'From' field
display_name="Your Name or Company"

# Email address to display in the 'From' header (REQUIRED)
# This is the email address that recipients will see as the sender
from_email="your_display_email@yourdomain.com"

# Freesend API Key (REQUIRED)
# Get your API key from https://freesend.metafog.io/docs/configuration/api-keys
FREESEND_API_KEY="YOUR_FREESEND_API_KEY"

# Freesend API URL (OPTIONAL - default is https://freesend.metafog.io/api/send-email)
# Only change this if you are using a custom Freesend API endpoint
FREESEND_API_URL="https://freesend.metafog.io/api/send-email"